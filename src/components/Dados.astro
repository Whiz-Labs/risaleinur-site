---
import Icon from './Icon.astro';
import Faixa from './Faixa.astro';
import { instituicao, diretoria, documentos } from '../config';

// Diretoria e documentos são opcionais: só aparecem quando há dado real.
const temDiretoria = diretoria.some((d) => d.nome);
const docs = documentos.filter((d): d is { title: string; file: string } => Boolean(d.file));
---

<section id="dados" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">A associação</span>
      <h2>Dados institucionais</h2>
      <p>
        A ARN é uma entidade legalmente registrada. Todos os dados podem ser conferidos nos
        órgãos públicos.
      </p>
    </div>

    <div class="dados-inner">
      <div class="registro">
        <dl class="registro-grid">
          <div>
            <dt>Razão social</dt>
            <dd>{instituicao.razaoSocial}</dd>
          </div>
          <div>
            <dt>Nome fantasia</dt>
            <dd>{instituicao.nomeFantasia}</dd>
          </div>
          <div>
            <dt>CNPJ</dt>
            <dd>{instituicao.cnpj}</dd>
            <a class="registro-link" href={instituicao.consultaUrl} target="_blank" rel="noopener">
              Consultar na Receita Federal <Icon name="external" size={14} />
            </a>
          </div>
          <div>
            <dt>Natureza jurídica</dt>
            <dd>{instituicao.naturezaJuridica}</dd>
          </div>
          <div>
            <dt>Data de fundação</dt>
            <dd>{instituicao.fundacao}</dd>
          </div>
          {
            instituicao.situacao && (
              <div>
                <dt>Situação cadastral</dt>
                <dd class="registro-situacao">
                  <span aria-hidden="true" />
                  {instituicao.situacao}
                </dd>
              </div>
            )
          }
        </dl>
        <Faixa />
      </div>

      {
        (temDiretoria || docs.length > 0) && (
          <div class="dados-lado">
            {temDiretoria && (
              <div class="bloco">
                <h3>Diretoria</h3>
                <dl class="diretoria">
                  {diretoria.map((d) => (
                    <div>
                      <dt>{d.cargo}</dt>
                      <dd>{d.nome || 'a informar'}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}

            {docs.length > 0 && (
              <div class="bloco">
                <h3>Documentos</h3>
                <ul class="docs">
                  {docs.map((d) => (
                    <li>
                      <a href={d.file} target="_blank" rel="noopener">
                        <Icon name="file" size={20} />
                        {d.title} (PDF)
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .dados-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .registro {
    flex: 2 1 35rem;
    min-width: 0;
    border: 1px solid var(--borda);
    border-radius: var(--radius-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .registro-grid {
    padding: 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13.75rem, 1fr));
    gap: 1.5rem 2rem;
  }

  dt {
    font-size: 0.875rem;
    color: var(--texto-mudo);
  }

  dd {
    font-weight: 600;
  }

  .registro-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .registro-situacao {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .registro-situacao span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--verde);
  }

  .dados-lado {
    flex: 1 1 20rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .bloco {
    background: var(--papel);
    border-radius: var(--radius-card);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .bloco h3 {
    font-size: 1.125rem;
  }

  .diretoria {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .diretoria div {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 1rem;
  }

  .diretoria dt {
    font-size: 1rem;
  }

  .docs {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .docs a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .registro-grid {
      padding: 1.5rem;
    }
  }
</style>
