---
import Faixa from './Faixa.astro';
import Icon from './Icon.astro';
import { site, instituicao, diretoria, documentos, contact } from '../config';

const year = new Date().getFullYear();
const { address } = contact;

// Os dados institucionais ficam no rodapé, não numa seção própria. Diretoria
// e documentos são opcionais: só aparecem quando há dado real.
const nomes = diretoria.filter((d) => d.nome);
const docs = documentos.filter((d): d is { title: string; file: string } => Boolean(d.file));
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-col">
      <img
        src="/logo-horizontal-escuro.svg"
        alt={`${site.name} – ${site.fullName}`}
        width="242"
        height="64"
        loading="lazy"
      />
      <span>
        {address.street && `${address.street} – `}{address.district}, {address.city} – {address.state}
        · CEP {address.zip}
      </span>
      {contact.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
      <span>
        <a href={`https://wa.me/${contact.whatsapp}`}>WhatsApp {contact.whatsappLabel}</a>
        · <a href={contact.instagram}>Instagram {contact.instagramHandle}</a>
      </span>
    </div>

    <div class="footer-col">
      <h2 class="footer-titulo">Dados institucionais</h2>
      <strong>{instituicao.razaoSocial}</strong>
      <span>
        CNPJ {instituicao.cnpj} ·{' '}
        <a class="nowrap" href={instituicao.consultaUrl} target="_blank" rel="noopener">
          Consultar na Receita Federal <Icon name="external" size={13} />
        </a>
      </span>
      <span>
        {instituicao.naturezaJuridica} · Fundada em {instituicao.fundacao}
        {instituicao.situacao && ` · Situação: ${instituicao.situacao}`}
      </span>
      {
        nomes.length > 0 && (
          <span>Diretoria: {nomes.map((d) => `${d.nome} (${d.cargo})`).join(' · ')}</span>
        )
      }
      {
        docs.length > 0 && (
          <span>
            {docs.map((d, i) => (
              <>
                {i > 0 && ' · '}
                <a href={d.file} target="_blank" rel="noopener">
                  {d.title} (PDF)
                </a>
              </>
            ))}
          </span>
        )
      }
    </div>
  </div>
  <div class="container footer-copy">
    © {year} {site.name} · Associação privada sem fins lucrativos
  </div>
  <Faixa />
</footer>

<style>
  .footer {
    background: var(--tinta);
    color: var(--rodape-texto);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem 3rem;
    padding-block: 3rem 2rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 34rem;
    font-size: 0.9375rem;
  }

  .footer-col img {
    height: 64px;
    width: auto;
    align-self: flex-start;
    margin-bottom: 0.75rem;
  }

  .footer-titulo {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amarelo);
    margin-bottom: 0.4rem;
  }

  .footer-col strong {
    color: var(--branco);
    font-weight: 600;
  }

  .footer a {
    color: var(--rodape-texto);
  }

  .footer a:hover {
    color: var(--branco);
  }

  .nowrap {
    white-space: nowrap;
  }

  .footer a :global(svg) {
    display: inline;
    vertical-align: -1px;
  }

  .footer-copy {
    padding-bottom: 1.75rem;
    font-size: 0.8125rem;
    color: #9aa59e;
  }
</style>
