---
import Faixa from './Faixa.astro';
import { site, feira } from '../config';

interface Props {
  /** Mostra a faixa da feira (só na home; a própria /feira não precisa). */
  faixaFeira?: boolean;
}

const { faixaFeira = true } = Astro.props;

// Links com "/" na frente para funcionarem também a partir de /feira.
const links = [
  { href: '/#sobre', label: 'Quem somos' },
  { href: '/#atividades', label: 'Atividades' },
  { href: '/#dados', label: 'Dados institucionais' },
  { href: '/#galeria', label: 'Galeria' },
];

const standLabel = feira.stand ? `Estande ${feira.stand}` : '';
---

<Faixa />

{
  faixaFeira && (
    // Escondida no HTML; o script abaixo mostra entre showFrom e end, no fuso
    // da sede. Sem JS ela simplesmente não aparece — falha para o lado seguro.
    <a
      href="/feira"
      class="faixa-feira"
      hidden
      data-show-from={feira.showFrom}
      data-end={feira.end}
      data-tz={site.timeZone}
    >
      <span class="container faixa-feira-inner">
        <span class="faixa-feira-tag">Feira do livro</span>
        <span>
          Estaremos na {feira.shortName} · {feira.dateLabel}
          {standLabel && ` · ${standLabel}`}
        </span>
        <span class="faixa-feira-cta">Saiba mais</span>
      </span>
    </a>
  )
}

<header class="header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <img
        src="/logo-horizontal.svg"
        alt={`${site.name} – ${site.fullName}`}
        width="158"
        height="56"
      />
    </a>

    <input type="checkbox" id="nav-toggle" class="visually-hidden" />
    <label for="nav-toggle" class="nav-burger">
      <span></span><span></span><span></span>
      <span class="visually-hidden">Abrir menu</span>
    </label>

    <nav class="nav" aria-label="Menu principal">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="/#contato" class="btn btn-primary nav-cta">Contato</a>
    </nav>
  </div>
</header>

<script>
  // Compara datas AAAA-MM-DD no fuso da sede — "hoje" para o visitante de
  // outro fuso tem de ser o "hoje" de São Paulo.
  const el = document.querySelector<HTMLElement>('.faixa-feira');
  if (el) {
    const { showFrom = '', end = '', tz = 'America/Sao_Paulo' } = el.dataset;
    const today = new Intl.DateTimeFormat('en-CA', {
      timeZone: tz,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(new Date());
    if (today >= showFrom && today <= end) el.hidden = false;
  }
</script>

<style>
  /* ---------- Faixa da feira ---------- */
  .faixa-feira {
    display: block;
    background: var(--floresta);
    color: var(--branco);
    text-decoration: none;
  }

  .faixa-feira:hover {
    color: var(--branco);
  }

  .faixa-feira-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.375rem 1rem;
    min-height: 44px;
    padding-block: 0.625rem;
    font-size: 0.9375rem;
    text-align: center;
  }

  .faixa-feira-tag {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amarelo);
  }

  .faixa-feira-cta {
    font-weight: 600;
    text-decoration: underline;
  }

  /* ---------- Cabeçalho ---------- */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--branco);
    border-bottom: 1px solid var(--borda);
  }

  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 5.25rem;
  }

  .brand img {
    height: 56px;
    width: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.25rem 1.5rem;
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .nav a:not(.btn) {
    color: var(--tinta);
    text-decoration: none;
    padding: 0.625rem 0;
  }

  .nav a:not(.btn):hover {
    color: var(--verde-escuro);
  }

  .nav-cta {
    min-height: 44px;
    padding: 0 1.25rem;
    font-size: 0.9375rem;
  }

  .nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    align-items: center;
    cursor: pointer;
  }

  .nav-burger span:not(.visually-hidden) {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--tinta);
    border-radius: 2px;
  }

  #nav-toggle:focus-visible + .nav-burger {
    outline: 3px solid var(--azul);
    outline-offset: 2px;
    border-radius: 8px;
  }

  @media (max-width: 900px) {
    .header-inner {
      min-height: 4.5rem;
    }

    .brand img {
      height: 46px;
    }

    .nav-burger {
      display: flex;
    }

    /* Menu sem JS: o checkbox escondido guarda o estado. */
    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem 1.5rem 1.25rem;
      background: var(--branco);
      border-bottom: 1px solid var(--borda);
      box-shadow: var(--shadow);
    }

    #nav-toggle:checked ~ .nav {
      display: flex;
    }

    .nav a:not(.btn) {
      padding: 0.875rem 0;
      border-bottom: 1px solid var(--borda);
    }

    .nav-cta {
      margin-top: 1rem;
      min-height: 52px;
    }
  }
</style>
