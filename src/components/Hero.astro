---
// Hero "de cena": foto de fundo em tela cheia, véu --floresta para o texto,
// e uma estante de capas reais (de `livros`) que fica metade sobre a foto e
// metade sobre o branco. Inspirado numa referência enviada pelo cliente, mas
// nas cores/tipos do site.
import Faixa from './Faixa.astro';
import { hero, livros } from '../config';

const capas = hero.estante.titulos
  .map((t) => livros.itens.find((i) => i.title === t))
  .filter((i): i is (typeof livros.itens)[number] => Boolean(i));
const meio = Math.floor(capas.length / 2);
---

<section id="inicio" class:list={['cena', capas.length > 0 && 'cena--estante']}>
  <div class="cena-fundo" aria-hidden="true">
    {hero.photo && <img src={hero.photo.src} alt="" width={hero.photo.width} height={hero.photo.height} loading="eager" fetchpriority="high" />}
  </div>

  <div class="container cena-texto">
    <span class="eyebrow cena-eyebrow">{hero.eyebrow}</span>
    <h1>{hero.title}</h1>
    <Faixa height={6} width="120px" />
    <p class="cena-lead">{hero.lead}</p>
    <div class="cena-ctas">
      <a href="#sobre" class="btn btn-amarelo">Conheça a ARN</a>
      <a href="#contato" class="btn cena-btn-claro">Visite-nos</a>
    </div>
    <ul class="cena-facts">
      {hero.facts.map((f) => <li>{f}</li>)}
    </ul>
  </div>

  {
    capas.length > 0 && (
      <div class="container">
        <div class="card estante">
          <ul class="estante-capas">
            {capas.map((c, i) => (
              <li class:list={[i === meio && 'is-meio', Math.abs(i - meio) > 1 && 'is-ponta']}>
                <img src={c.cover} alt={c.title} width="480" height="640" loading="eager" decoding="async" />
              </li>
            ))}
          </ul>
          <div class="estante-rodape">
            <span class="estante-label">{hero.estante.label}</span>
            <a href="#livros" class="btn btn-primary">
              {hero.estante.cta} <span aria-hidden="true">→</span>
            </a>
          </div>
          <Faixa height={6} />
        </div>
      </div>
    )
  }
</section>

<style>
  .cena {
    position: relative;
    isolation: isolate;
    /* Quanto da estante fica abaixo da foto, sobre o branco. */
    --sobra: 9rem;
  }

  .cena-fundo {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--floresta);
  }

  .cena--estante .cena-fundo {
    bottom: var(--sobra);
  }

  .cena-fundo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  /* Véu: sólido sob o texto, abre para a direita; base escurece para a estante. */
  .cena-fundo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(18 61 42 / 0) 55%, rgb(18 61 42 / 0.55) 100%),
      linear-gradient(90deg, rgb(18 61 42 / 0.94) 0%, rgb(18 61 42 / 0.82) 42%, rgb(18 61 42 / 0.35) 75%, rgb(18 61 42 / 0.2) 100%);
  }

  .cena-texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2.5rem, 5vw, 3.5rem);
    color: var(--branco);
  }

  .cena-texto > * {
    max-width: 38rem;
  }

  .cena-eyebrow {
    color: var(--amarelo);
  }

  .cena h1 {
    color: var(--branco);
  }

  .cena-lead {
    font-size: 1.1875rem;
    color: rgb(255 255 255 / 0.88);
  }

  .cena-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  .cena-btn-claro {
    color: var(--branco);
    border-color: rgb(255 255 255 / 0.7);
  }

  .cena-btn-claro:hover {
    background: rgb(255 255 255 / 0.12);
    color: var(--branco);
  }

  .cena-facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.75);
  }

  @media (min-width: 701px) {
    .cena-facts li + li::before {
      content: '·';
      margin-right: 1.5rem;
      margin-left: -0.75rem;
      color: var(--amarelo);
    }
  }

  /* ---------- Estante ---------- */
  .estante {
    overflow: hidden;
  }

  .estante-capas {
    list-style: none;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: clamp(0.5rem, 2vw, 1.75rem);
    padding: 1.75rem 1.5rem 0;
    background: linear-gradient(180deg, var(--branco) 70%, var(--papel) 100%);
  }

  .estante-capas li {
    flex: 0 1 9.5rem;
  }

  .estante-capas li.is-meio {
    flex-basis: 11.5rem;
  }

  .estante-capas img {
    width: 100%;
    /* Capas têm fundo branco: multiply some com ele sobre o gradiente. */
    mix-blend-mode: multiply;
  }

  .estante-rodape {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.75rem 1.5rem;
    border-top: 1px solid var(--borda);
  }

  .estante-label {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--tinta);
  }

  @media (max-width: 700px) {
    .cena {
      --sobra: 6rem;
    }

    .cena-fundo::after {
      background: linear-gradient(180deg, rgb(18 61 42 / 0.8) 0%, rgb(18 61 42 / 0.88) 100%);
    }

    .cena-ctas .btn {
      flex: 1 1 auto;
    }

    .estante-capas li.is-ponta {
      display: none;
    }

    .estante-rodape {
      padding-inline: 1.25rem;
    }

    .estante-rodape .btn {
      flex: 1 1 auto;
    }
  }
</style>
