---
import Foto from './Foto.astro';
import Faixa from './Faixa.astro';
import { hero } from '../config';
---

<section id="inicio" class="hero section--papel">
  <div class="container hero-inner">
    <div class="hero-text">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1>{hero.title}</h1>
      <p class="hero-lead">{hero.lead}</p>
      <div class="hero-ctas">
        <a href="#sobre" class="btn btn-primary">Conheça a ARN</a>
        <a href="#contato" class="btn btn-outline">Visite-nos</a>
      </div>
      <ul class="hero-facts">
        {hero.facts.map((f) => <li>{f}</li>)}
      </ul>
    </div>
    <Foto class="hero-foto" photo={hero.photo} hint={hero.photoHint} height="440px" eager>
      <Faixa height={8} class="hero-faixa" />
    </Foto>
  </div>
</section>

<style>
  .hero-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 3rem;
    padding-block: clamp(3rem, 7vw, 4.5rem);
  }

  .hero-text {
    flex: 1 1 26rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
  }

  .hero-lead {
    font-size: 1.1875rem;
    color: var(--texto-suave);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.375rem;
  }

  .hero-facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.875rem;
    color: var(--texto-mudo);
    padding-top: 0.375rem;
  }

  .hero-foto {
    flex: 1 1 26rem;
    min-width: 0;
  }

  .hero-foto :global(.hero-faixa) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }

  @media (max-width: 600px) {
    .hero-foto {
      height: 280px !important;
    }

    .hero-ctas .btn {
      flex: 1 1 auto;
    }
  }
</style>
