---
import Icon from './Icon.astro';
import { livros, whatsappHref } from '../config';
---

{
  livros.itens.length > 0 && (
    <section id="livros" class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">{livros.eyebrow}</span>
          <h2>{livros.title}</h2>
          <p>{livros.text}</p>
        </div>

        <ul class="livros-grid">
          {livros.itens.map((l) => (
            <li class="livro">
              <img
                src={l.cover}
                alt={`Capa do livro ${l.title}`}
                width="480"
                height="640"
                loading="lazy"
                decoding="async"
              />
              <h3>{l.title}</h3>
              {l.subtitle && <p class="livro-sub">{l.subtitle}</p>}
              {l.author && <p class="livro-autor">{l.author}</p>}
            </li>
          ))}
        </ul>

        <a href={whatsappHref} class="btn btn-primary livros-cta" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} /> {livros.cta}
        </a>
      </div>
    </section>
  )
}

<style>
  .livros-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 2rem 1.25rem;
    margin-bottom: 2.5rem;
  }

  .livro {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .livro img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    margin-bottom: 0.5rem;
  }

  .livro h3 {
    font-size: 1rem;
    line-height: 1.3;
  }

  .livro-sub,
  .livro-autor {
    font-size: 0.875rem;
    color: var(--texto-suave);
  }

  .livro-autor {
    color: var(--texto-mudo);
  }

  @media (max-width: 600px) {
    .livros-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem 1rem;
    }

    .livros-cta {
      width: 100%;
    }
  }
</style>
