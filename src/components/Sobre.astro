---
import Foto from './Foto.astro';
import Faixa from './Faixa.astro';
import { sobre } from '../config';
---

<section id="sobre" class="section">
  <div class="container sobre-inner">
    <Foto class="sobre-foto" photo={sobre.photo} hint={sobre.photoHint} height="380px" bg="#E6ECE7" />
    <div class="sobre-text">
      <span class="eyebrow">{sobre.eyebrow}</span>
      <h2>{sobre.title}</h2>
      <Faixa width="120px" />
      {sobre.paragraphs.map((p) => <p class="lead">{p}</p>)}
    </div>
  </div>
</section>

<style>
  .sobre-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 3.5rem;
  }

  .sobre-foto {
    flex: 1 1 22rem;
    min-width: 0;
  }

  .sobre-text {
    flex: 1 1 30rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  @media (max-width: 600px) {
    .sobre-inner {
      gap: 2rem;
    }

    .sobre-foto {
      height: 260px !important;
    }
  }
</style>
