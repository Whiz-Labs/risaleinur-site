---
// Destino do formulário de contato quando o envio é feito sem JS (o Netlify
// redireciona para cá após o POST). Com JS, a confirmação aparece no próprio
// formulário e esta página não é vista.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Faixa from '../components/Faixa.astro';
import { site, formulario } from '../config';
---

<BaseLayout title={`Mensagem enviada – ${site.name}`} noindex>
  <Header faixaFeira={false} />
  <main id="conteudo" class="section section--papel obrigado">
    <div class="container obrigado-inner">
      <span class="eyebrow">{formulario.eyebrow}</span>
      <h1>{formulario.sucesso}</h1>
      <Faixa height={6} width="120px" />
      <a href="/" class="btn btn-primary">Voltar ao início</a>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .obrigado-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 44rem;
    min-height: 40vh;
  }

  .obrigado h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }
</style>
